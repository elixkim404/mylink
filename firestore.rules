rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 및 본인 확인 헬퍼 함수
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 프로필 데이터 유효성 검증 (/edit 프로필 편집 제약사항 반영)
    function isValidProfileData(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('display_name' in request.resource.data) || (request.resource.data.display_name is string && request.resource.data.display_name.size() >= 1 && request.resource.data.display_name.size() <= 30))
        && (!('handle' in request.resource.data) || (request.resource.data.handle is string && request.resource.data.handle.size() >= 1 && request.resource.data.handle.size() <= 30))
        && (!('badge' in request.resource.data) || request.resource.data.badge == null || (request.resource.data.badge is string && request.resource.data.badge.size() <= 40))
        && (!('bio' in request.resource.data) || request.resource.data.bio == null || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('avatar_url' in request.resource.data) || request.resource.data.avatar_url is string)
        && (!('socials' in request.resource.data) || request.resource.data.socials is map);
    }

    // 링크 데이터 유효성 검증
    function isValidLinkData() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 100
        && request.resource.data.url is string
        && request.resource.data.url.matches('^https?://.+');
    }

    // 방문자(비로그인 포함 누구나) 링크 클릭 시 click_count 필드만 +1 증가하는지 확인
    function isOnlyClickCountIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['click_count'])
        && request.resource.data.click_count is int
        && (
          (resource.data.get('click_count', 0) is int
            && request.resource.data.click_count == resource.data.get('click_count', 0) + 1)
          || (!(resource.data.get('click_count', 0) is int)
            && request.resource.data.click_count == 1)
        );
    }

    // 1. 유저 루트 문서 (현재 앱의 프로필 조회·검색·편집 경로: users/{userId})
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidProfileData(userId);
      allow delete: if isOwner(userId);

      // 2. 프로필 하위 경로 (users/{userId}/profile/{docId})
      match /profile/{docId=**} {
        allow read: if true;
        allow create, update: if isOwner(userId) && isValidProfileData(userId);
        allow delete: if isOwner(userId);
      }

      // 3. 링크 서브컬렉션 (users/{userId}/links/{linkId})
      match /links/{linkId} {
        allow read: if true;
        allow create: if isOwner(userId) && isValidLinkData();
        allow delete: if isOwner(userId);
        allow update: if (isOwner(userId) && isValidLinkData())
                      || isOnlyClickCountIncrement();
      }

      // 4. 응원 메시지 서브컬렉션 (users/{userId}/cheers/{cheerId})
      match /cheers/{cheerId} {
        allow read: if true;
        allow create: if request.resource.data.author is string
                      && request.resource.data.author.size() >= 1
                      && request.resource.data.author.size() <= 10
                      && request.resource.data.content is string
                      && request.resource.data.content.size() >= 1
                      && request.resource.data.content.size() <= 60;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // 그 외 명시되지 않은 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
